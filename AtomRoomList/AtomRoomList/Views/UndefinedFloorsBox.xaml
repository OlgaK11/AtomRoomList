<controls:AtomWindow x:Class="AtomRoomList.Views.UndefinedFloorsBox"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:viewmodels="clr-namespace:AtomRoomList.ViewModels"
                     xmlns:controls="clr-namespace:AtomStyle.Controls;assembly=AtomStyle"
                     xmlns:wpf="clr-namespace:AtomStyle.Additional;assembly=AtomStyle"
                     d:DataContext="{d:DesignInstance Type=viewmodels:UndefinedFloorsVM}"
                     mc:Ignorable="d"
                     Loaded="AtomWindow_Loaded"
                     ShowSettingsButton="False"
                     Title="Список помещений"
                     Height="600" Width="800"
                     MinHeight="400" MinWidth="600">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <DynamicResource ResourceKey="AtomMainWindow" />
    </Window.Style>

    <Grid Margin="0 16 0 0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="Полы, для которых список помещений не определен."
                       Style="{StaticResource AtomMediumTextBlock}" />
        </Grid>

        <Grid Grid.Row="1"
              Margin="0 8 0 0">
            <DataGrid x:Name="floorsDataGrid"
                      ItemsSource="{Binding AtomFloors}"
                      IsReadOnly="True"
                      SelectionChanged="FloorsDataGrid_SelectionChanged"
                      Style="{StaticResource AtomMaterialDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id"
                                        Width="120"
                                        Binding="{Binding ElementId.IntegerValue}" />

                    <DataGridTextColumn Header="Имя типоразмера"
                                        Width="*"
                                        Binding="{Binding TypeName}"
                                        CellStyle="{StaticResource AtomMaterialDataGridCellLeft}" />

                    <DataGridTextColumn Header="Уровень"
                                        Width="150"
                                        Binding="{Binding AtomLevel.Name}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Top"
                    Margin="0 4 0 0">
            <controls:AtomSelectionControl SelectAllButtonClick="SelectAllButton_Click"
                                           UnselectAllButtonClick="UnselectAllButton_Click" />

            <Button Margin="24 0 0 0"
                    Command="{Binding SelectInModelDelegateCommand}"
                    Style="{StaticResource AtomGreenIconButton}"
                    wpf:AtomIconAssist.Icon="SelectInModel"
                    wpf:ButtonAssist.Circled="True" />

            <Button Command="{Binding SelectionBoxDelegateCommand}"
                    Margin="4 0 0 0"
                    ToolTip="Рамка выбора"
                    Style="{StaticResource AtomGreenIconButton}"
                    wpf:AtomIconAssist.Icon="SelectionBox"
                    wpf:ButtonAssist.Circled="True" />

            <CheckBox Content="Динамический выбор"
                      IsChecked="{Binding IsDynamicSelection}"
                      Margin="24 0 0 0"
                      ToolTip="Автоматический выбор полов в модели" />
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Margin="0 24 0 0"
                    HorizontalAlignment="Center">
            <Button Content="Закрыть"
                    IsCancel="True"
                    Click="CloseButton_Click"
                    Style="{StaticResource AtomOutlinedGrayButton}" />
        </StackPanel>
    </Grid>
</controls:AtomWindow>